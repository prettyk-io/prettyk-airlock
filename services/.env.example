# COS-059: Cosmoport delivery profile — environment template.
# Copy to .env (same dir as docker-compose.yml) and adjust per-environment.
# NEVER commit real .env — this template contains dev defaults only.

# ── PostgreSQL ──────────────────────────────────────────────────────
COSMO_PG_USER=cosmo
COSMO_PG_PASSWORD=cosmo
COSMO_PG_DB=cosmo

# ── MinIO / S3 (profile: full) ──────────────────────────────────────
COSMO_MINIO_USER=cosmo
COSMO_MINIO_PASSWORD=cosmo-minio-dev

# ── OpenBao (platform) ────────────────────────────────────────────────
# COS-173: единый платформенный OpenBao (docker-compose.openbao.yml, сеть pk-infra).
# Cosmo ходит через AppRole cosmo-app (rw secret/cosmo/*). Creds — runtime-secrets,
# кладутся в .env (gitignored), НЕ в этот template.
VAULT_APPROLE_ROLE_ID=
VAULT_APPROLE_SECRET_ID=

# ── Woodpecker agent secret (profile: full) ─────────────────────────
# Generate: openssl rand -hex 32
COSMO_WOODPECKER_AGENT_SECRET=dev-agent-secret-change-me

# ── Edge ────────────────────────────────────────────────────────────
# Registry upstream for Caddy /registry/* route (docker-internal DNS)
REGISTRY_ZR_HOST=cosmo-registry-zr:5000
